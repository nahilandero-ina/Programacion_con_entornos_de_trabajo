<%- include('partials/header.ejs') %>


    <section>
        <h2>Nuestros productos</h2>

        <h3><%= product.nombre %></h3>

        <h2>$ <%= product.precio %></h2>
        <ul>
            <li><strong>Categoría</strong>: <%= product.categoria %></li>
            <li><strong>Descripción</strong>: <%= product.descripcion %></li>
            <li><strong>Stock</strong>: <%= product.stock %></li>
        </ul>
    </section>

    <section>
        <a href="/editProduct/:id<%=product.id%>"> Editar </a>
        <form action="/products/delete/<%=product.id%>?_method=DELETE" method="post">
            <button>Eliminar</button>
        </form>
    </section>



    <%- include('partials/footer.ejs') %>