<%- include('partials/header.ejs') %>

    <section>
        <h2>Usuarios</h2>
        <h3><%= user.nombre %></h3>
        <h3><%= user.correo %></h3>
    </section>

    <section>
        <a href="/users/editUser/<%=user.id%>">Editar</a>
        <form action="/users/delete/<%=user.id%>?_method=DELETE" method="post">
            <button type="submit">Eliminar</button>
        </form>
    </section>

    <%- include('partials/footer.ejs') %>