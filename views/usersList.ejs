<%- include('partials/header.ejs') %>

    <h2>Usuarios</h2>
    <% users.forEach(usuario=> {%>
        <article>
            <a href="/users/detail/<%= usuario.id %>">
                <h4>
                    <%= usuario.nombre %>
                </h4>
            </a>
            <p><%= usuario.correo %>
            </p>

        </article>

        <% }) %>

            <%- include('partials/footer.ejs') %>