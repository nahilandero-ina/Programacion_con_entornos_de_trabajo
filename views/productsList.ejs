<%- include('partials/header.ejs') %>

    <h2>Nuestros productos</h2>
    <% products.forEach(producto=> {%>
        <article>
            <a href="/products/detail/<%= producto.id %>">
                <h4>
                    <%= producto.nombre %>
                </h4>
            </a>
            <p>$ <%= producto.precio %></p>
        </article>

        <% }) %>

            <%- include('partials/footer.ejs') %>